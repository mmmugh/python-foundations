#!/bin/sh
# leak-scan: read a unified diff on stdin; exit 1 if any ADDED line
# (or added file PATH) matches a deny pattern, 0 otherwise. Used by the
# pre-commit and pre-push hooks.
#
# Scope on purpose:
#   - ADDED lines only. Removing a leak (a '-' line) or an unchanged context line
#     is never blocked — otherwise you couldn't scrub one out.
#   - Added file PATHS are scanned too (a leak can hide in a new/renamed filename).
#   - Generic shapes (leak-patterns) match CASE-SENSITIVELY, so the lowercase
#     '/users/' REST route is not flagged; personal literals (leak-patterns.local)
#     match case-INSENSITIVELY, so an employer name matches in any casing.
#   - Known blind spot (fail loud, not silent): binary blobs produce no '+' lines,
#     so a secret inside a committed binary is NOT seen. Don't commit binaries with
#     secrets; *.sqlite is already gitignored.
#
# Patterns: one ERE per line; whole-line '#' comments and blanks ignored.
#   leak-patterns        tracked, generic shapes only (SAFE to publish)
#   leak-patterns.local  untracked, your personal literals (NEVER committed)
# Override either path with LEAK_PATTERNS / LEAK_PATTERNS_LOCAL (the test does).
# CALLERS MUST PASS -c core.quotePath=false. Git otherwise writes a non-ASCII
# path as quoted octal escapes ("b/Caf\303\251-Corp.md"), which no pattern
# for the real name can match, and which does not even match the '+++ b/'
# rule. The scanner cannot undo that encoding from here, so the hooks set the
# flag and anything calling this by hand must too.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PATTERNS="${LEAK_PATTERNS:-$here/leak-patterns}"
PATTERNS_LOCAL="${LEAK_PATTERNS_LOCAL:-$here/leak-patterns.local}"

diff=$(mktemp); work=$(mktemp); pg=$(mktemp); pl=$(mktemp)
trap 'rm -f "$diff" "$work" "$pg" "$pl"' EXIT

cat > "$diff"

# ADDED content (hunk-aware: only in-hunk '+' lines, strip the leading '+';
# never the pre-hunk '+++'/'---' file headers or '-'/context lines). Robust to
# content lines that themselves begin with '+'.
#
# The '\ No newline at end of file' marker is skipped rather than treated as
# the end of the hunk. Without that skip it is none of '+', '-' or ' ', so it
# cleared inhunk and every '+' line after it went unscanned -- and git emits
# it mid-hunk whenever the OLD version of a file had no trailing newline. That
# was a real bypass: appending a token to such a file passed the scan.
awk '/^@@/{inhunk=1;next} /^\\/{next} /^[+ -]/{if(inhunk&&substr($0,1,1)=="+")print substr($0,2);next} {inhunk=0}' "$diff" > "$work"

# ADDED file paths (new-file / rename / copy targets).
grep -E '^\+\+\+ b/|^rename to |^copy to ' "$diff" 2>/dev/null \
  | sed -E -e 's|^\+\+\+ b/||' -e 's|^rename to ||' -e 's|^copy to ||' >> "$work" || true

# ADDED paths that have NO text hunk, which the rule above therefore misses:
# a new binary file emits only "Binary files ... differ", and a new EMPTY file
# emits no hunk at all, so neither produces a '+++ b/' header. Both still
# carry a filename, and a filename can hold a token or an employer's name.
# "new file mode" marks an addition specifically -- a DELETED file must not be
# scanned by path, or a badly named file could never be removed.
#
# The path is recovered by length, not by splitting. "diff --git a/P b/P"
# repeats the SAME path, so the remainder after "diff --git " is always
# 2*len(P)+5 characters and P starts at offset 3. Splitting on " b/" instead
# is wrong whenever the path itself contains " b/" -- a folder named "notes b"
# is enough -- and git does NOT quote a path merely for holding a space, so
# that is reachable rather than theoretical.
awk '/^diff --git /{r=substr($0,12); n=(length(r)-5)/2;
                     p=(n>0)?substr(r,3,n):""; next}
     /^new file mode /{if (p != "") print p; next}' "$diff" >> "$work" || true

[ -s "$work" ] || exit 0

# grep exits 0 on a match, 1 on none, and 2 on an error such as a pattern
# that will not compile. `|| true` used to treat all three alike -- and one
# bad pattern makes grep abandon the whole -f run, so the VALID patterns in
# that list stopped matching too. A single unbalanced parenthesis turned a
# list off, and every scan passed. An error now fails the scan. grep's own
# message is discarded rather than echoed, in case some grep quotes the
# offending pattern back; the list is named instead.
search() {  # $1 = filtered pattern file, $2 = the list's name; the rest go to grep
  list=$1; name=$2; shift 2
  status=0
  found=$(grep -E "$@" -f "$list" "$work" 2>/dev/null) || status=$?
  if [ "$status" -eq 0 ]; then
    matched=$found
  elif [ "$status" -ne 1 ]; then
    echo "leak-scan: ERROR — a pattern in $name will not compile (grep exit $status), so nothing in that list can be checked; fix the list" >&2
    exit 2
  fi
}

matched=""
if [ -f "$PATTERNS" ]; then
  sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$PATTERNS" > "$pg"
  if [ -s "$pg" ]; then
    search "$pg" "$PATTERNS"
  fi
fi
if [ -z "$matched" ] && [ -f "$PATTERNS_LOCAL" ]; then
  sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$PATTERNS_LOCAL" > "$pl"
  if [ -s "$pl" ]; then
    search "$pl" "$PATTERNS_LOCAL" -i
  fi
fi

if [ -n "$matched" ]; then
  echo "leak-scan: BLOCKED — added content matches a deny pattern:" >&2
  printf '%s\n' "$matched" | sed 's/^/    /' >&2
  echo "  Patterns: $PATTERNS (+ $PATTERNS_LOCAL if present)" >&2
  exit 1
fi
exit 0
